# Ambientes virtuais
venv/
.venv/
env/
ENV/

# Bytecode / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / distribuição
build/
dist/
*.egg-info/
.eggs/

# Testes e cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Tipagem / lint
.mypy_cache/
.ruff_cache/

# Dados brutos (não versionados: as planilhas do BACEN são baixadas à mão e o
# CNEFE tem 580 MB)
# (padrão com /* em vez de /, para que a negação do .gitkeep funcione)
data/raw/*
!data/raw/.gitkeep

# O mapa GERADO fica fora da `main`. Ele é o artefato publicado no GitHub
# Pages, e vive na branch órfã `gh-pages`, junto do `index.html` que redireciona
# para ele.
#
# O custo que motivou a separação foi medido: o folium sorteia os
# identificadores dos elementos a cada execução, então duas gerações do MESMO
# dado diferem em ~106 mil trechos e o git não consegue guardar só o delta —
# cada versão commitada soma o arquivo INTEIRO ao histórico, para sempre. Eram
# ~1,1 MB por safra com o mapa do Sul; com o nacional, ~5 MB. Numa branch órfã
# o custo continua existindo, mas fica isolado do histórico do código: clonar o
# repositório para trabalhar nele não arrasta mais nenhum mapa.
#
# Publicar uma safra nova é substituir o HTML na `gh-pages`; a `main` não muda.
output/*.html

# Jupyter
.ipynb_checkpoints/

# Editores / SO
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Variáveis de ambiente
.env
.env.local
