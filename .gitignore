# Ambientes virtuais
venv/
.venv/
env/
ENV/

# Bytecode / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / distribuição
build/
dist/
*.egg-info/
.eggs/

# Testes e cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Tipagem / lint
.mypy_cache/
.ruff_cache/

# Dados brutos (não versionados: as planilhas do BACEN são baixadas à mão e o
# CNEFE tem 580 MB)
# (padrão com /* em vez de /, para que a negação do .gitkeep funcione)
data/raw/*
!data/raw/.gitkeep

# O mapa NÃO entra aqui de propósito: ele é o artefato publicado no GitHub
# Pages, e o site serve o arquivo versionado. O custo é conhecido e foi medido:
# o folium sorteia os identificadores dos elementos a cada execução, então duas
# gerações do MESMO dado diferem em ~106 mil trechos e o git não consegue
# guardar só o delta — cada versão commitada soma ~1,1 MB permanentes ao
# histórico. Em ritmo de safra do BACEN isso é irrelevante; se algum dia o mapa
# passar a ser regerado com frequência, migrar para uma branch gh-pages órfã
# resolve sem reescrever o histórico da main.

# Jupyter
.ipynb_checkpoints/

# Editores / SO
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Variáveis de ambiente
.env
.env.local
